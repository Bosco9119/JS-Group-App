{
  "expo": {
    "name": "JS-Group-App",
    "slug": "JS-Group-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "jsgroupapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jsgroup.mobile",
      "icon": "./assets/images/app-icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.jsgroup.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow JS Group Driver to access your photos and videos for delivery proof.",
          "cameraPermission": "Allow JS Group Driver to take delivery proof photos and videos.",
          "microphonePermission": "Allow JS Group Driver to record audio when capturing proof videos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow JS Group Driver to use your location for proof of delivery and trip operations."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#C9A227",
          "defaultChannel": "default"
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7fad943-532d-4958-a5b3-3d4af898caa3"
      }
    }
  }
}
